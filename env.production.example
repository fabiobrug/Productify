# Variáveis de ambiente para produção no Vercel
# Configure estas variáveis no painel do Vercel

# Database Configuration (Neon)
DATABASE_HOST=your-neon-host
DATABASE_PORT=5432
DATABASE_NAME=your-database-name
DATABASE_USER=your-database-user
DATABASE_PASSWORD=your-database-password
DATABASE_URL=postgresql://your-database-user:your-database-password@your-neon-host:5432/your-database-name

# Application Configuration
NODE_ENV=production
PORT=3000

# Security
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=https://productify.vercel.app
